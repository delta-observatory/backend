{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-observatory.local/contracts/records/reproduction-report/v1.schema.json",
  "title": "Reproduction report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "source_run_id",
    "repeat_run_id",
    "status",
    "runtime_match",
    "comparison",
    "compared",
    "differences",
    "notes"
  ],
  "properties": {
    "contract": {
      "const": "reproduction-report/1"
    },
    "source_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "repeat_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "matched",
        "different",
        "unavailable"
      ]
    },
    "runtime_match": {
      "type": "boolean"
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absolute",
        "relative",
        "meaning"
      ],
      "properties": {
        "absolute": {
          "const": 1e-12
        },
        "relative": {
          "const": 1e-10
        },
        "meaning": {
          "const": "Numerical agreement only. These tolerances do not measure scientific uncertainty."
        }
      }
    },
    "compared": {
      "type": "integer",
      "minimum": 0
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "reason"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
