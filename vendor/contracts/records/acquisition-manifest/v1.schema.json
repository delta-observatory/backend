{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-observatory.org/contracts/records/acquisition-manifest/v1.schema.json",
  "title": "acquisition-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "source",
    "dataset_id",
    "request",
    "products"
  ],
  "properties": {
    "contract": {
      "const": "acquisition-manifest/1"
    },
    "source": {
      "const": "MAST"
    },
    "dataset_id": {
      "const": "tess-spoc-light-curves"
    },
    "request": {
      "$ref": "https://delta-observatory.org/contracts/records/acquisition-request/v1.schema.json"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "filename",
          "bytes",
          "observation_id",
          "sector",
          "tic_id",
          "processing_version"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "^mast:TESS/product/[A-Za-z0-9._-]+_lc\\.fits$",
            "maxLength": 300
          },
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+_lc\\.fits$",
            "maxLength": 220
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483648
          },
          "observation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sector": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "tic_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999999999999999
          },
          "processing_version": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200
          }
        }
      }
    }
  }
}
