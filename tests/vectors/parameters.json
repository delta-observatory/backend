{
 "method": {
  "id": "tess-bls",
  "version": 1
 },
 "schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-observatory.local/contracts/methods/tess-bls/v1.schema.json",
  "title": "tess-bls parameters, version 1",
  "description": "Box least squares (BLS) transit search on one TESS SPOC light curve. The worker keeps rows with QUALITY equal to 0 and finite, positive flux and error. It normalizes the flux, removes the trend with a Savitzky-Golay filter, and searches a period grid. The defaults are the fixed T01 settings.",
  "x-method": {
   "kind": "analysis",
   "summary": "Box least squares transit search",
   "scientific_basis": "detection/exoplanets/transits-bls/README.md",
   "implementation": "lightkurve LightCurve.normalize and flatten, astropy.timeseries.BoxLeastSquares autopower",
   "evidence": "experiments/tess-known-planet-recovery/README.md",
   "scientific_status": "Provisional. Guided recovery of two known planets in TESS sector 2 only. Depth accuracy, completeness, and false-alarm rates are not validated. Trend removal changes transit depths.",
   "known_deviation": "astropy autoperiod can extend the period grid slightly past maximum_period. The worker records the actual grid bounds as diagnostics."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
   "flux_column",
   "flatten",
   "search",
   "minimum_rows",
   "minimum_baseline_days"
  ],
  "properties": {
   "flux_column": {
    "description": "SPOC flux column. pdcsap_flux has systematic-error correction. sap_flux is simple aperture photometry.",
    "enum": [
     "pdcsap_flux",
     "sap_flux"
    ],
    "default": "pdcsap_flux"
   },
   "minimum_rows": {
    "description": "The smallest number of retained rows that permits a search.",
    "type": "integer",
    "minimum": 100,
    "maximum": 1000000,
    "default": 5000,
    "x-unit": "1"
   },
   "minimum_baseline_days": {
    "description": "The shortest time span of retained rows that permits a search.",
    "type": "number",
    "minimum": 1,
    "maximum": 1000,
    "default": 10,
    "x-unit": "d"
   },
   "flatten": {
    "description": "Trend removal with lightkurve flatten (Savitzky-Golay filter with iterative sigma clipping). It removes stellar and instrumental variation longer than the window, and it can reduce transit depth.",
    "type": "object",
    "additionalProperties": false,
    "required": [
     "window_length",
     "polyorder",
     "break_tolerance",
     "niters",
     "sigma"
    ],
    "properties": {
     "window_length": {
      "description": "Filter window in cadences. It must be odd. At 120 s cadence, 1001 cadences is about 1.39 d.",
      "type": "integer",
      "minimum": 11,
      "maximum": 20001,
      "default": 1001,
      "x-unit": "cadence",
      "not": {
       "multipleOf": 2
      }
     },
     "polyorder": {
      "description": "Polynomial order of the filter.",
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "default": 2,
      "x-unit": "1"
     },
     "break_tolerance": {
      "description": "A gap longer than this number of cadences splits the series into separate filter segments.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 5,
      "x-unit": "cadence"
     },
     "niters": {
      "description": "Number of sigma-clipping iterations for the trend fit.",
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 3,
      "x-unit": "1"
     },
     "sigma": {
      "description": "Clipping threshold for the trend fit, in standard deviations.",
      "type": "number",
      "minimum": 1,
      "maximum": 20,
      "default": 3,
      "x-unit": "1"
     }
    }
   },
   "search": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "minimum_period",
     "maximum_period",
     "duration_days",
     "frequency_factor",
     "oversample",
     "objective",
     "maximum_grid_trials"
    ],
    "properties": {
     "minimum_period": {
      "description": "Shortest trial period.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100,
      "default": 0.5,
      "x-unit": "d"
     },
     "maximum_period": {
      "description": "Longest trial period. A transit needs at least two events in the series to define a period.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100,
      "default": 10.0,
      "x-unit": "d"
     },
     "duration_days": {
      "description": "Trial transit durations. Each must be shorter than minimum_period.",
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
       "type": "number",
       "exclusiveMinimum": 0,
       "maximum": 2
      },
      "default": [
       0.04,
       0.06,
       0.08,
       0.1,
       0.12,
       0.16,
       0.2
      ],
      "x-unit": "d"
     },
     "frequency_factor": {
      "description": "Grid spacing factor for astropy autoperiod. A smaller value gives a finer grid and more trials.",
      "type": "number",
      "minimum": 0.05,
      "maximum": 10,
      "default": 1.0,
      "x-unit": "1"
     },
     "oversample": {
      "description": "Number of transit-time samples in each trial duration.",
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10,
      "x-unit": "1"
     },
     "objective": {
      "description": "likelihood: log-likelihood improvement of the box model. snr: signal-to-noise ratio of the depth.",
      "enum": [
       "likelihood",
       "snr"
      ],
      "default": "likelihood"
     },
     "maximum_grid_trials": {
      "description": "Resource limit. The worker stops before the search when the period grid has more trials.",
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000,
      "default": 100000,
      "x-unit": "1"
     }
    }
   }
  },
  "x-constraints": [
   "search.minimum_period < search.maximum_period",
   "max(search.duration_days) < search.minimum_period"
  ]
 },
 "defaults": {
  "flux_column": "pdcsap_flux",
  "minimum_rows": 5000,
  "minimum_baseline_days": 10,
  "flatten": {
   "window_length": 1001,
   "polyorder": 2,
   "break_tolerance": 5,
   "niters": 3,
   "sigma": 3
  },
  "search": {
   "minimum_period": 0.5,
   "maximum_period": 10.0,
   "duration_days": [
    0.04,
    0.06,
    0.08,
    0.1,
    0.12,
    0.16,
    0.2
   ],
   "frequency_factor": 1.0,
   "oversample": 10,
   "objective": "likelihood",
   "maximum_grid_trials": 100000
  }
 },
 "cases": [
  {
   "override": {},
   "schema_paths": [],
   "rules": []
  },
  {
   "override": {
    "flatten": {
     "window_length": 1000
    }
   },
   "schema_paths": [
    "flatten.window_length"
   ],
   "rules": []
  },
  {
   "override": {
    "flatten": {
     "window_length": 5
    }
   },
   "schema_paths": [
    "flatten.window_length"
   ],
   "rules": []
  },
  {
   "override": {
    "flatten": {
     "window_length": 1001.5
    }
   },
   "schema_paths": [
    "flatten.window_length"
   ],
   "rules": []
  },
  {
   "override": {
    "search": {
     "minimum_period": 12
    }
   },
   "schema_paths": [],
   "rules": [
    "search.minimum_period < search.maximum_period"
   ]
  },
  {
   "override": {
    "search": {
     "minimum_period": 0.1
    }
   },
   "schema_paths": [],
   "rules": [
    "max(search.duration_days) < search.minimum_period"
   ]
  },
  {
   "override": {
    "search": {
     "maximum_period": 0.4
    }
   },
   "schema_paths": [],
   "rules": [
    "search.minimum_period < search.maximum_period"
   ]
  },
  {
   "override": {
    "search": {
     "duration_days": [
      0.1,
      0.1
     ]
    }
   },
   "schema_paths": [
    "search.duration_days"
   ],
   "rules": []
  },
  {
   "override": {
    "search": {
     "duration_days": []
    }
   },
   "schema_paths": [
    "search.duration_days"
   ],
   "rules": []
  },
  {
   "override": {
    "search": {
     "duration_days": [
      3
     ]
    }
   },
   "schema_paths": [
    "search.duration_days.0"
   ],
   "rules": []
  },
  {
   "override": {
    "search": {
     "objective": "chi2"
    }
   },
   "schema_paths": [
    "search.objective"
   ],
   "rules": []
  },
  {
   "override": {
    "flux_column": "kspsap"
   },
   "schema_paths": [
    "flux_column"
   ],
   "rules": []
  },
  {
   "override": {
    "minimum_rows": 99
   },
   "schema_paths": [
    "minimum_rows"
   ],
   "rules": []
  },
  {
   "override": {
    "search": {
     "frequency_factor": 0.01
    }
   },
   "schema_paths": [
    "search.frequency_factor"
   ],
   "rules": []
  },
  {
   "override": {
    "search": {
     "maximum_period": 20
    }
   },
   "schema_paths": [],
   "rules": []
  },
  {
   "override": {
    "search": {
     "minimum_period": 0,
     "maximum_period": 101
    }
   },
   "schema_paths": [
    "search.maximum_period",
    "search.minimum_period"
   ],
   "rules": []
  }
 ]
}
