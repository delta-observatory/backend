{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delta-observatory.org/contracts/records/acquisition-result/v1.schema.json",
  "title": "acquisition-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "files",
    "outcome",
    "message"
  ],
  "properties": {
    "contract": {
      "const": "acquisition-result/1"
    },
    "files": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "bytes",
          "sha256",
          "state",
          "message"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483648
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "enum": [
              "complete",
              "failed",
              "pending"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "complete",
        "failed",
        "cancelled"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 0,
      "maxLength": 1000
    }
  }
}
